# Entity: transformation

main: kit: entity: transformation: {

  alias: field: {}

  fields: [
    {
      name: "deletedAt"
      req: false
      short: "Deletion timestamp if transformation is deleted"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the transformation"
      type: "`$INTEGER`"
    }
    {
      name: "image"
      req: false
      short: "URL to transformation image"
      type: "`$STRING`"
    }
    {
      name: "ki"
      req: false
      short: "Ki level in this transformation"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Name of the transformation"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "transformation"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 10
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/transformations"
          parts: [
            "transformations"
          ]
          select: {
            exist: [
              "limit"
              "page"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/transformations/{id}"
          parts: [
            "transformations"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
