# Entity: planet

main: kit: entity: planet: {

  alias: field: {}

  fields: {
    deletedAt: {
      fo: "date-time"
      h: "Deleted At"
      n: "deletedAt"
      r: false
      sh: "Deletion timestamp if planet is deleted"
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "Detailed description of the planet"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the planet"
      t: "`$INTEGER`"
    }
    image: {
      fo: "uri"
      h: "Image"
      n: "image"
      r: false
      sh: "URL to planet image"
      t: "`$STRING`"
    }
    isDestroyed: {
      h: "Is Destroyed"
      n: "isDestroyed"
      r: false
      sh: "Whether the planet has been destroyed"
      t: "`$BOOLEAN`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Name of the planet"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "planet"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /planets"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 10
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "name"
                or: "name"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/planets"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "planets"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.items`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /planets/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/planets/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "planets"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
