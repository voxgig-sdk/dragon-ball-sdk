# Entity: transformation

main: kit: entity: transformation: {

  alias: field: {}

  fields: {
    deletedAt: {
      fo: "date-time"
      h: "Deleted At"
      n: "deletedAt"
      r: false
      sh: "Deletion timestamp if transformation is deleted"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the transformation"
      t: "`$INTEGER`"
    }
    image: {
      fo: "uri"
      h: "Image"
      n: "image"
      r: false
      sh: "URL to transformation image"
      t: "`$STRING`"
    }
    ki: {
      h: "Ki"
      n: "ki"
      r: false
      sh: "Ki level in this transformation"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Name of the transformation"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "transformation"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /transformations"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 10
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/transformations"
          q: {
            exist: [
              "limit"
              "page"
            ]
          }
          s: [
            {
              lit: "transformations"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /transformations/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/transformations/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "transformations"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
