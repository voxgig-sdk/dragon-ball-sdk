# Entity: planet

main: kit: entity: planet: {

  alias: field: {}

  fields: [
    {
      name: "deletedAt"
      req: false
      short: "Deletion timestamp if planet is deleted"
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      short: "Detailed description of the planet"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the planet"
      type: "`$INTEGER`"
    }
    {
      name: "image"
      req: false
      short: "URL to planet image"
      type: "`$STRING`"
    }
    {
      name: "isDestroyed"
      req: false
      short: "Whether the planet has been destroyed"
      type: "`$BOOLEAN`"
    }
    {
      name: "name"
      req: false
      short: "Name of the planet"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "planet"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 10
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "name"
                orig: "name"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/planets"
          parts: [
            "planets"
          ]
          select: {
            exist: [
              "limit"
              "name"
              "page"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/planets/{id}"
          parts: [
            "planets"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
