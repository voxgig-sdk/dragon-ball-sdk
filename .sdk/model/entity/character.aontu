# Entity: character

main: kit: entity: character: {

  alias: field: {}

  fields: {
    affiliation: {
      h: "Affiliation"
      n: "affiliation"
      r: false
      sh: "Character's affiliation or allegiance"
      t: "`$STRING`"
    }
    deletedAt: {
      fo: "date-time"
      h: "Deleted At"
      n: "deletedAt"
      r: false
      sh: "Deletion timestamp if character is deleted"
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "Detailed description of the character"
      t: "`$STRING`"
    }
    gender: {
      h: "Gender"
      n: "gender"
      r: false
      sh: "Gender of the character"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the character"
      t: "`$INTEGER`"
    }
    image: {
      fo: "uri"
      h: "Image"
      n: "image"
      r: false
      sh: "URL to character image"
      t: "`$STRING`"
    }
    ki: {
      h: "Ki"
      n: "ki"
      r: false
      sh: "Current ki (power level) of the character"
      t: "`$STRING`"
    }
    maxKi: {
      h: "Max Ki"
      n: "maxKi"
      r: false
      sh: "Maximum ki the character can achieve"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Name of the character"
      t: "`$STRING`"
    }
    originPlanet: {
      h: "Origin Planet"
      n: "originPlanet"
      r: false
      sh: "Planet where the character originated"
      t: "`$OBJECT`"
    }
    race: {
      h: "Race"
      n: "race"
      r: false
      sh: "Race or species of the character"
      t: "`$STRING`"
    }
    transformations: {
      h: "Transformations"
      n: "transformations"
      r: false
      sh: "List of transformations available to the character"
      t: "`$ARRAY`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "character"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /characters"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "affiliation"
                or: "affiliation"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 10
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "name"
                or: "name"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "race"
                or: "race"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/characters"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "characters"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.items`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /characters/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/characters/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "characters"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
